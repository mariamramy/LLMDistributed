          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Worker 1 health returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const generationModel = pm.environment.get('generation_model') || pm.collectionVariables.get('generation_model');",
                  "const embeddingModel = pm.environment.get('embedding_model') || pm.collectionVariables.get('embedding_model');",
                  "const minChunkCount = Number(pm.environment.get('min_chunk_count') || pm.collectionVariables.get('min_chunk_count') || 1);",
                  "",
                  "pm.test('Worker 1 readiness fields match Ollama/RAG config', function () {",
                  "  pm.expect(body.worker_id).to.eql('worker-1');",
                  "  pm.expect(body.status).to.eql('ok');",
                  "  pm.expect(body.llm_provider).to.eql('ollama');",
                  "  pm.expect(body.llm_ready).to.eql(true);",
                  "  pm.expect(body.rag_ready).to.eql(true);",
                  "  pm.expect(body.chroma_ready).to.eql(true);",
                  "  pm.expect(body.model).to.eql(generationModel);",
                  "  pm.expect(body.embedding_model).to.eql(embeddingModel);",
                  "  pm.expect(body.chunk_count).to.be.at.least(minChunkCount);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
