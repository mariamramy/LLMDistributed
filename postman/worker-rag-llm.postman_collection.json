        {
          "name": "Task With RAG - Slow Local Model",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_id\": \"postman-rag-{{$timestamp}}\",\n  \"request_id\": \"postman-request-rag\",\n  \"prompt\": \"{{sample_prompt}}\",\n  \"use_rag\": true\n}"
            },
            "url": {
              "raw": "{{worker_1_base_url}}/task",
              "host": [
                "{{worker_1_base_url}}"
              ],
              "path": [
                "task"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('RAG task completes', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const generationModel = pm.environment.get('generation_model') || pm.collectionVariables.get('generation_model');",
                  "const ragTopK = Number(pm.environment.get('rag_top_k') || pm.collectionVariables.get('rag_top_k') || 3);",
                  "",
                  "pm.test('RAG task returns the stable worker response shape', function () {",
                  "  pm.expect(body.status).to.eql('completed');",
                  "  pm.expect(body.worker_id).to.eql('worker-1');",
                  "  pm.expect(body.result).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.latency_ms).to.be.a('number');",
                  "  pm.expect(body.rag.used).to.eql(true);",
                  "  pm.expect(body.rag.sources).to.be.an('array');",
                  "  pm.expect(body.rag.sources.length).to.be.above(0);",
                  "  pm.expect(body.rag.sources.length).to.be.at.most(ragTopK);",
                  "  pm.expect(body.llm.model).to.eql(generationModel);",
                  "  pm.expect(body.llm.usage).to.be.an('object');",
                  "});",
                  "",
                  "pm.test('RAG sources include textbook metadata', function () {",
                  "  const source = body.rag.sources[0];",
                  "  pm.expect(source.source_file).to.be.a('string').and.not.empty;",
                  "  pm.expect(source.page).to.be.a('number');",
                  "  pm.expect(source.chunk_id).to.be.a('string').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
