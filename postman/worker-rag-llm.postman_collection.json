{
  "info": {
    "_postman_id": "4c04fc40-390c-43a7-8b7e-7968fec91f69",
    "name": "LLMDistributed Worker/RAG/Ollama API",
    "description": "Local smoke tests for the worker-owned layer: Ollama model availability, Ollama embeddings, ChromaDB heartbeat, worker health/metrics, RAG task execution, no-RAG task execution, and validation errors. The task requests call the local model and can be slow on older laptops.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Ollama",
      "item": [
        {
          "name": "Tags",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ollama_base_url}}/api/tags",
              "host": [
                "{{ollama_base_url}}"
              ],
              "path": [
                "api",
                "tags"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Ollama tags returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const generationModel = pm.environment.get('generation_model') || pm.collectionVariables.get('generation_model');",
                  "const embeddingModel = pm.environment.get('embedding_model') || pm.collectionVariables.get('embedding_model');",
                  "const names = (body.models || []).map((model) => model.name || '');",
                  "",
                  "pm.test('Ollama has models installed', function () {",
                  "  pm.expect(body.models).to.be.an('array');",
                  "  pm.expect(body.models.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test('Generation model is installed', function () {",
                  "  pm.expect(names.some((name) => name === generationModel || name.startsWith(generationModel + ':'))).to.eql(true);",
                  "});",
                  "",
                  "pm.test('Embedding model is installed', function () {",
                  "  pm.expect(names.some((name) => name === embeddingModel || name.startsWith(embeddingModel + ':'))).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Embed Smoke",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
