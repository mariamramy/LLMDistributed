            "url": {
              "raw": "{{ollama_base_url}}/api/embed",
              "host": [
                "{{ollama_base_url}}"
              ],
              "path": [
                "api",
                "embed"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Ollama embed returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Embedding response has one vector', function () {",
                  "  pm.expect(body.embeddings).to.be.an('array').with.lengthOf(1);",
                  "  pm.expect(body.embeddings[0]).to.be.an('array');",
                  "  pm.expect(body.embeddings[0].length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
